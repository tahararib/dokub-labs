#!/usr/bin/env bash
# ============================================================
# dokub — commande de l'environnement des labs DOKUB
# Capability Forge / Tahar ARIB
#
#   dokub cluster up       crée le cluster des labs (3 nœuds) et ses compléments
#   dokub cluster down     supprime le cluster
#   dokub cluster status   état des nœuds, des compléments et des images
#   dokub images           récupère les images externes et vérifie celles de taskboard
#   dokub mesure           mesure démarrage, passage à l'échelle et mises à jour de taskboard
#   dokub lab start NN     remet le cluster dans l'état de début du lab NN
#   dokub lab check NN     vérifie les points de contrôle du lab NN
# ============================================================
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"   # racine du dépôt dokub-labs
CLUSTER=dokub
CTX="kind-$CLUSTER"
CPK_NAME=cloud-provider-kind

# Images externes utilisées par les labs : récupérées une fois sur le master,
# puis présentes dans le Docker de chaque poste cloné (aucun accès Internet en session).
# Avec Internet en session, les nœuds téléchargent eux-mêmes les images publiques ;
# on ne garde sur le poste que celles qui évitent une attente au lab 0 et au lab 1.
CPK_IMAGE=registry.k8s.io/cloud-provider-kind/cloud-controller-manager:v0.12.0
# Registre d'images local (lab 1, étape 6) : les nœuds y tirent les images taskboard
REG_NAME=kind-registry
REG_PORT=5001
REG="localhost:$REG_PORT"
REG_IMAGE=registry:3
EXTERNAL_IMAGES=(
  postgres:16-alpine
  kindest/node:v1.37.0
  "$CPK_IMAGE"
  "$REG_IMAGE"
)
TASKBOARD_IMAGES=(taskboard:1.0.0 taskboard:2.0.0 taskboard:3.0.0)

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; CYAN='\033[0;36m'; NC='\033[0m'
log()  { echo -e "\n${CYAN}$*${NC}"; }
ok()   { echo -e "  ${GREEN}[OK] $*${NC}"; }
warn() { echo -e "  ${YELLOW}[!]  $*${NC}"; }
ko()   { echo -e "  ${RED}[KO] $*${NC}"; }
die()  { ko "$*"; exit 1; }
k()    { kubectl --context "$CTX" "$@"; }

cluster_exists() { kind get clusters 2>/dev/null | grep -qx "$CLUSTER"; }

# kubectl et kind sont installés par les participants au lab 1
need_tools() {
    command -v kubectl >/dev/null && command -v kind >/dev/null \
        || die "kubectl ou kind absent : installez-les (lab 1, étapes 1 et 2)"
}

# Registre local : conteneur registry:3 publié sur localhost:5001, relié au réseau « kind » ;
# chaque nœud reçoit un hosts.toml qui redirige localhost:5001 vers http://kind-registry:5000
# (dans un nœud, « localhost » désigne le nœud lui-même, pas le poste).
setup_registry() {
    if [ "$(docker inspect -f '{{.State.Running}}' "$REG_NAME" 2>/dev/null)" != "true" ]; then
        docker rm -f "$REG_NAME" >/dev/null 2>&1 || true
        docker run -d --name "$REG_NAME" --restart=always -p "127.0.0.1:$REG_PORT:5000" "$REG_IMAGE" >/dev/null
    fi
    docker network connect kind "$REG_NAME" >/dev/null 2>&1 || true   # déjà relié : sans effet
    local d="/etc/containerd/certs.d/$REG" n
    for n in $(kind get nodes --name "$CLUSTER"); do
        docker exec "$n" mkdir -p "$d"
        echo "[host.\"http://$REG_NAME:5000\"]" | docker exec -i "$n" tee "$d/hosts.toml" >/dev/null
    done
}

# Étiquette et pousse les images taskboard du poste dans le registre local
push_images() {
    local v
    for v in 1.0.0 2.0.0 3.0.0; do
        docker image inspect "taskboard:$v" >/dev/null 2>&1 || die "taskboard:$v absente du poste"
        docker tag "taskboard:$v" "$REG/taskboard:$v"
        docker push -q "$REG/taskboard:$v" >/dev/null
        echo "    $REG/taskboard:$v poussée"
    done
}

# Diagnostic affiché quand un déploiement n'aboutit pas dans le délai
diag() {   # diag <namespace> <label>
    warn "Diagnostic :"
    kubectl --context "$CTX" -n "$1" get pods -l "$2" -o wide
    kubectl --context "$CTX" -n "$1" get events --sort-by=.lastTimestamp | tail -8
}

# ────────────────────────────────────────────────
cmd_images() {
    log "Images externes"
    for img in "${EXTERNAL_IMAGES[@]}"; do
        if docker image inspect "$img" >/dev/null 2>&1; then ok "$img déjà présente"
        else docker pull -q "$img" >/dev/null && ok "$img récupérée"; fi
    done
    log "Images taskboard"
    for img in "${TASKBOARD_IMAGES[@]}"; do
        docker image inspect "$img" >/dev/null 2>&1 && ok "$img présente" \
            || ko "$img absente : cd ~/taskboard && bash dokub/build-images.sh"
    done
}

# ────────────────────────────────────────────────
cmd_cluster_up() {
    need_tools
    local t0=$SECONDS
    log "[1/5] Cluster kind « $CLUSTER » (1 control plane + 2 workers)"
    if cluster_exists; then ok "déjà créé"
    else
        kind create cluster --config "$ROOT/cluster/kind-dokub.yaml" --wait 180s
    fi
    k wait --for=condition=Ready nodes --all --timeout=180s >/dev/null
    ok "3 nœuds Ready ($((SECONDS - t0)) s)"

    log "[2/5] cloud-provider-kind (Services LoadBalancer et Gateway API)"
    if [ "$(docker inspect -f '{{.State.Running}}' "$CPK_NAME" 2>/dev/null)" = "true" ]; then
        ok "déjà démarré"
    else
        docker rm -f "$CPK_NAME" >/dev/null 2>&1 || true
        # --restart unless-stopped : redémarre avec Docker, donc après un redémarrage de WSL
        docker run -d --name "$CPK_NAME" --restart unless-stopped --network host \
            -v /var/run/docker.sock:/var/run/docker.sock \
            "$CPK_IMAGE" >/dev/null
        ok "démarré"
    fi

    log "[3/5] metrics-server (kubectl top, HorizontalPodAutoscaler)"
    k apply -f "$ROOT/cluster/metrics-server.yaml" >/dev/null
    ok "manifeste appliqué (les métriques arrivent ~60 s après le démarrage)"

    log "[4/5] Registre local et images taskboard"
    setup_registry
    push_images
    ok "Registre $REG prêt, nœuds configurés, images taskboard poussées"

    log "[5/5] Vérification"
    k rollout status deployment/metrics-server -n kube-system --timeout=180s >/dev/null && ok "metrics-server prêt"
    ok "Cluster des labs prêt en $((SECONDS - t0)) s au total"
}

cmd_cluster_down() {
    docker rm -f "$CPK_NAME" >/dev/null 2>&1 || true
    kind delete cluster --name "$CLUSTER"
    ok "Cluster $CLUSTER et cloud-provider-kind supprimés (le registre $REG est conservé)"
}

cmd_cluster_status() {
    cluster_exists || { warn "Cluster $CLUSTER absent : dokub cluster up"; return; }
    k get nodes -o wide
    echo; k get deploy -n kube-system metrics-server
    echo; docker ps --filter "name=$CPK_NAME" --format 'cloud-provider-kind : {{.Status}}'
    echo; docker ps --filter "name=$REG_NAME" --format 'registre {{.Names}} : {{.Status}}'
    echo "Images du registre : $(curl -fsS "http://$REG/v2/taskboard/tags/list" 2>/dev/null || echo 'registre absent')"
}

# ────────────────────────────────────────────────
# Mesure : rejoue les mécanismes des labs 2, 4, 7 et 9 et chronomètre chaque étape.
# Résultats utilisés pour les sorties attendues et les délais du carnet.
cmd_mesure() {
    cluster_exists || die "Cluster absent : dokub cluster up"
    local NS=mesure
    declare -A R   # résultats
    k delete namespace "$NS" --ignore-not-found --wait=true >/dev/null
    k create namespace "$NS" >/dev/null
    local kn="kubectl --context $CTX -n $NS"

    log "[1/7] PostgreSQL"
    local t=$SECONDS
    $kn apply -f "$ROOT/manifests/mesure/postgres.yaml" >/dev/null
    $kn rollout status deploy/postgres --timeout=180s >/dev/null || { diag "$NS" app=postgres; exit 1; }
    R[postgres]=$((SECONDS - t)); ok "PostgreSQL prêt en ${R[postgres]} s"

    log "[2/7] taskboard 1.0.0, 1 réplica (premier démarrage d'une JVM)"
    t=$SECONDS
    $kn apply -f "$ROOT/manifests/mesure/taskboard.yaml" >/dev/null
    $kn rollout status deploy/taskboard --timeout=300s >/dev/null || { diag "$NS" app=taskboard; exit 1; }
    R[demarrage]=$((SECONDS - t)); ok "1 pod prêt en ${R[demarrage]} s"
    $kn logs deploy/taskboard | grep -o "Started TaskboardApplication in [0-9.]* seconds" | sed 's/^/  Spring : /' || true

    log "[3/7] Boucle de requêtes en continu (pod « charge », 2 requêtes/s, délai 10 s, LENT au-delà de 2 s)"
    $kn run charge --image=busybox:1.37 --restart=Never -- sh -c \
        'while true; do s=$(date +%s); r=$(wget -qO- -T 10 http://taskboard/api/version 2>&1); c=$?; d=$(( $(date +%s) - s )); if [ $c -ne 0 ]; then echo "ERREUR $(date +%T) ${d}s $r"; elif [ $d -ge 2 ]; then echo "LENT $(date +%T) ${d}s $r"; else echo "$r"; fi; sleep 0.5; done' >/dev/null
    $kn wait --for=condition=Ready pod/charge --timeout=60s >/dev/null
    ok "boucle démarrée"

    log "[4/7] Passage à 3 réplicas"
    t=$SECONDS
    $kn scale deploy/taskboard --replicas=3 >/dev/null
    $kn rollout status deploy/taskboard --timeout=300s >/dev/null
    R[scale]=$((SECONDS - t)); ok "3 pods prêts en ${R[scale]} s"
    $kn get pods -l app=taskboard -o wide --no-headers | awk '{print "  " $1 " → " $7}'

    log "[5/7] Mise à jour progressive vers 2.0.0 (maxSurge 1, maxUnavailable 0)"
    t=$SECONDS
    $kn set image deploy/taskboard taskboard=$REG/taskboard:2.0.0 >/dev/null
    $kn rollout status deploy/taskboard --timeout=600s >/dev/null
    R[rollout]=$((SECONDS - t)); ok "rollout terminé en ${R[rollout]} s"
    sleep 3
    R[erreurs]=$($kn logs charge | grep -c ERREUR || true)
    [ "${R[erreurs]}" -eq 0 ] && ok "requêtes en erreur pendant le rollout : 0" \
                              || warn "requêtes en erreur pendant le rollout : ${R[erreurs]}"
    echo "  Réponses par version depuis le début :"
    $kn logs charge | grep -o "version=[0-9.]*" | sort | uniq -c | sed 's/^/   /'

    log "[5b/7] Rollout avec délai d'arrêt (preStop sleep 10 s)"
    # Cause mesurée (dokub diag-rollout, 20/11/2026) : après SIGTERM, un pod reçoit encore
    # des requêtes le temps que la sortie des EndpointSlices se propage aux règles de
    # kube-proxy ; Tomcat, en arrêt progressif, les garde sans répondre (attente de 10 s).
    # Le preStop ne s'applique qu'aux pods CRÉÉS après son ajout : on l'ajoute (rollout
    # non compté), puis on mesure le rollout suivant, qui arrête des pods qui le portent.
    $kn patch deploy/taskboard --type=json -p \
      '[{"op":"add","path":"/spec/template/spec/containers/0/lifecycle","value":{"preStop":{"sleep":{"seconds":10}}}}]' >/dev/null
    $kn rollout status deploy/taskboard --timeout=600s >/dev/null
    sleep 12   # laisse expirer les requêtes bloquées sur les pods arrêtés sans preStop
    local avant; avant=$($kn logs charge | grep -c ERREUR || true)
    t=$SECONDS
    $kn set image deploy/taskboard taskboard=$REG/taskboard:1.0.0 >/dev/null
    $kn rollout status deploy/taskboard --timeout=600s >/dev/null
    R[rollout_prestop]=$((SECONDS - t))
    sleep 12
    R[erreurs_prestop]=$(( $($kn logs charge | grep -c ERREUR || true) - avant ))
    ok "rollout 2.0.0 → 1.0.0 avec preStop terminé en ${R[rollout_prestop]} s ; requêtes en erreur : ${R[erreurs_prestop]}"

    log "[6/7] Version 3.0.0 défaillante : le rollout doit rester bloqué"
    $kn set image deploy/taskboard taskboard=$REG/taskboard:3.0.0 >/dev/null
    if $kn rollout status deploy/taskboard --timeout=90s >/dev/null 2>&1; then
        ko "le rollout v3 s'est terminé : la readiness n'a pas bloqué"
    else
        ok "rollout bloqué après 90 s, comme attendu"
    fi
    $kn get pods -l app=taskboard --no-headers | awk '{print "  " $1 "  READY " $2 "  " $3}'
    local p3; p3=$($kn get pods -l app=taskboard -o jsonpath='{range .items[*]}{.metadata.name} {.spec.containers[0].image}{"\n"}{end}' | awk '$2=="localhost:5001/taskboard:3.0.0"{print $1; exit}')
    if [ -n "$p3" ]; then
        # La readiness DOWN répond HTTP 503 : on lit la cause dans les événements et les logs
        echo "  Événements du pod $p3 :"
        $kn get events --field-selector "involvedObject.name=$p3,reason=Unhealthy" \
            -o custom-columns=MESSAGE:.message --no-headers | sort -u | sed 's/^/   /'
        echo "  Log applicatif :"
        $kn logs "$p3" | grep -o "Configuration incomplète.*" | head -1 | sed 's/^/   /'
    fi
    R[erreurs3]=$($kn logs charge | grep -c ERREUR || true)
    ok "requêtes en erreur au total (v1 → v2 → v3 bloquée) : ${R[erreurs3]}"
    t=$SECONDS
    $kn rollout undo deploy/taskboard >/dev/null
    $kn rollout status deploy/taskboard --timeout=300s >/dev/null
    R[undo]=$((SECONDS - t)); ok "rollout undo terminé en ${R[undo]} s"

    log "[7/7] Consommation mesurée (metrics-server)"
    if $kn top pods 2>/dev/null; then :; else warn "métriques pas encore disponibles (attendre 60 s puis : kubectl top pods -n $NS)"; fi
    echo; kubectl --context "$CTX" top nodes 2>/dev/null || true

    echo -e "\n${CYAN}Résumé à transmettre :${NC}"
    printf "  %-38s %s\n" "PostgreSQL prêt" "${R[postgres]} s" \
        "taskboard, 1er pod prêt" "${R[demarrage]} s" \
        "passage à 3 réplicas" "${R[scale]} s" \
        "rollout 1.0.0 → 2.0.0 (3 pods)" "${R[rollout]} s" \
        "erreurs pendant ce rollout" "${R[erreurs]}" \
        "rollout avec preStop sleep 10 s" "${R[rollout_prestop]} s" \
        "erreurs avec preStop" "${R[erreurs_prestop]}" \
        "rollout undo depuis la v3" "${R[undo]} s"
    echo -e "\n${CYAN}Requêtes en erreur ou lentes (≥ 2 s) : heure, durée, réponse :${NC}"
    $kn logs charge | grep -E "^(ERREUR|LENT)" | sed 's/^/  /' || echo "  aucune"
    echo -e "\n${CYAN}Chronologie des pods (création, suppression) :${NC}"
    $kn get events --sort-by=.lastTimestamp -o custom-columns=HEURE:.lastTimestamp,RAISON:.reason,OBJET:.involvedObject.name --no-headers \
        | grep -E "Killing|Started|SuccessfulCreate|SuccessfulDelete" | sed 's/^/  /' | tail -30
    echo -e "\nNettoyage : kubectl --context $CTX delete namespace $NS"
}

# ────────────────────────────────────────────────
# Test comparatif : d'où viennent les requêtes perdues pendant un rollout ?
# 3 configurations × 3 rollouts (bascule 1.0.0 ↔ 2.0.0), même boucle de requêtes.
#   A : configuration actuelle (arrêt « graceful » de Spring, sans preStop)
#   B : A + preStop sleep 10 s
#   C : B + arrêt immédiat de Spring (SERVER_SHUTDOWN=immediate)
cmd_diag_rollout() {
    cluster_exists || die "Cluster absent : dokub cluster up"
    local NS=diag kn="kubectl --context $CTX -n diag"
    k delete namespace "$NS" --ignore-not-found --wait=true >/dev/null
    k create namespace "$NS" >/dev/null
    log "Mise en place (PostgreSQL, taskboard × 3, boucle de requêtes)"
    $kn apply -f "$ROOT/manifests/mesure/postgres.yaml" >/dev/null
    $kn rollout status deploy/postgres --timeout=180s >/dev/null
    $kn apply -f "$ROOT/manifests/mesure/taskboard.yaml" >/dev/null
    $kn scale deploy/taskboard --replicas=3 >/dev/null
    $kn rollout status deploy/taskboard --timeout=300s >/dev/null
    $kn run charge --image=busybox:1.37 --restart=Never -- sh -c \
        'while true; do s=$(date +%s); r=$(wget -qO- -T 10 http://taskboard/api/version 2>&1); c=$?; d=$(( $(date +%s) - s )); if [ $c -ne 0 ]; then echo "ERREUR $(date +%T) ${d}s $r"; else echo "OK $(date +%T) $r"; fi; sleep 0.5; done' >/dev/null
    $kn wait --for=condition=Ready pod/charge --timeout=60s >/dev/null
    echo "  kube-proxy : mode $(k -n kube-system get cm kube-proxy -o jsonpath='{.data.config\.conf}' | awk '/^mode:/{print $2}')"

    local img=2.0.0 cfg n e0 e1
    declare -A RES
    for cfg in A B C; do
        log "Configuration $cfg"
        case $cfg in
          B) $kn patch deploy/taskboard --type=json -p '[{"op":"add","path":"/spec/template/spec/containers/0/lifecycle","value":{"preStop":{"sleep":{"seconds":10}}}}]' >/dev/null ;;
          C) $kn set env deploy/taskboard SERVER_SHUTDOWN=immediate >/dev/null ;;
        esac
        $kn rollout status deploy/taskboard --timeout=600s >/dev/null
        RES[$cfg]=""
        for n in 1 2 3; do
            sleep 5
            e0=$($kn logs charge | grep -c ERREUR || true)
            $kn set image deploy/taskboard taskboard=$REG/taskboard:$img >/dev/null
            $kn rollout status deploy/taskboard --timeout=600s >/dev/null
            sleep 12   # laisse expirer les requêtes en cours (délai 10 s)
            e1=$($kn logs charge | grep -c ERREUR || true)
            echo "  rollout $n (→ $img) : $((e1 - e0)) erreur(s)"
            RES[$cfg]+="$((e1 - e0)) "
            [ "$img" = 2.0.0 ] && img=1.0.0 || img=2.0.0
        done
    done

    echo -e "\n${CYAN}Résumé (erreurs par rollout) :${NC}"
    echo "  A  graceful, sans preStop        : ${RES[A]}"
    echo "  B  graceful + preStop 10 s       : ${RES[B]}"
    echo "  C  immédiat + preStop 10 s       : ${RES[C]}"
    echo -e "\n${CYAN}Erreurs (heure de fin, durée) :${NC}"
    $kn logs charge | grep ERREUR | sed 's/^/  /' || echo "  aucune"
    echo -e "\n${CYAN}Arrêts et démarrages de pods (UTC) :${NC}"
    $kn get events --sort-by=.lastTimestamp -o custom-columns=HEURE:.lastTimestamp,RAISON:.reason,OBJET:.involvedObject.name --no-headers \
        | grep -E " (Killing|Started) " | grep -v charge | sed 's/^/  /'
    echo -e "\nNettoyage : kubectl --context $CTX delete namespace $NS"
}

# ════════════════════════════════════════════════════════════
# LABS : « dokub lab start NN » remet le cluster dans l'état de début du lab NN ;
#        « dokub lab check NN » vérifie les points de contrôle et affiche
#        une ligne à coller dans le chat.
# ════════════════════════════════════════════════════════════
CHK_OK=0; CHK_N=0
chk() {   # chk "<libellé>" "<condition shell>" "<indice si échec>"
    CHK_N=$((CHK_N + 1))
    if eval "$2" >/dev/null 2>&1; then ok "$1"; CHK_OK=$((CHK_OK + 1))
    else ko "$1"; [ -n "${3:-}" ] && echo "       → $3"; fi
}
chk_fin() {
    local l
    l="LAB $1 · $CHK_OK/$CHK_N · $(hostname) · $(date +%H:%M)"
    echo
    if [ "$CHK_OK" -eq "$CHK_N" ]; then echo -e "${GREEN}${l}${NC}"; else echo -e "${YELLOW}${l}${NC}"; fi
    echo "  ↑ collez cette ligne dans le chat"
}
lb_ip() { k -n taskboard get svc taskboard-lb -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null; }
avail() { k -n "$1" get deploy "$2" -o jsonpath='{.status.availableReplicas}' 2>/dev/null; }
gw_ip() { k -n taskboard get gateway entree -o jsonpath='{.status.addresses[0].value}' 2>/dev/null; }
# Champ du modèle de pod du Deployment taskboard : tpl '.containers[0].image'
tpl() { k -n taskboard get deploy taskboard -o jsonpath="{.spec.template.spec$1}" 2>/dev/null; }
# Exactement 3 pods taskboard, tous prêts : aucun pod en trop (Pending, CrashLoop, rollout inachevé)
toutes_pretes() {
    local l; l=$(k -n taskboard get pods -l app=taskboard --no-headers 2>/dev/null)
    [ "$(echo "$l" | grep -c .)" -eq 3 ] && [ "$(echo "$l" | awk '$2=="1/1" && $3=="Running"' | wc -l)" -eq 3 ]
}

cmd_lab_check() {
    local n=${1:-}
    log "Points de contrôle du lab $n"
    case $n in
      00)
        chk "image taskboard:1.0.0 présente sur le poste" "docker image inspect taskboard:1.0.0" "dokub images"
        chk "image postgres:16-alpine présente sur le poste" "docker image inspect postgres:16-alpine" "dokub images"
        chk "pile docker compose du lab 0 arrêtée" "[ -z \"\$(docker compose -p lab00 ps -q)\" ]" "cd ~/dokub-labs/labs/lab00 && docker compose down"
        ;;
      01)
        chk "kubectl installé, version 1.37" "kubectl version --client -o json | jq -r .clientVersion.gitVersion | grep -q '^v1\.37\.'" "étape 1"
        chk "kind installé" "command -v kind" "étape 2"
        chk "cluster kind « dokub » créé" "cluster_exists" "kind create cluster --config ~/dokub-labs/cluster/kind-dokub.yaml"
        chk "3 nœuds Ready" "[ \$(k get nodes --no-headers | grep -c ' Ready ') -eq 3 ]" "kubectl get nodes ; kubectl describe node <nœud>"
        chk "API server en version v1.37.0" "k version -o json | jq -r .serverVersion.gitVersion | grep -qx v1.37.0"
        chk "cloud-provider-kind démarré" "[ \"\$(docker inspect -f '{{.State.Running}}' cloud-provider-kind)\" = true ]" "étape 5"
        chk "metrics-server disponible" "[ \"\$(avail kube-system metrics-server)\" = 1 ]" "étape 5, suite"
        chk "registre local démarré" "[ \"\$(docker inspect -f '{{.State.Running}}' kind-registry)\" = true ]" "étape 6"
        chk "nœuds configurés pour le registre" "(for n in \$(kind get nodes --name dokub); do docker exec \$n test -f /etc/containerd/certs.d/localhost:5001/hosts.toml || exit 1; done)" "étape 6, boucle hosts.toml"
        chk "3 images taskboard dans le registre" "[ \$(curl -fsS http://localhost:5001/v2/taskboard/tags/list | jq '.tags | length') -eq 3 ]" "étape 6, suite"
        chk "scheduler de nouveau en marche" "k -n kube-system get pod kube-scheduler-dokub-control-plane -o jsonpath='{.status.phase}' | grep -qx Running" "remettre kube-scheduler.yaml dans /etc/kubernetes/manifests (panne, c)"
        chk "pod de test supprimé" "! k -n default get pod test" "kubectl delete pod test -n default"
        ;;
      02)
        chk "namespace taskboard" "k get namespace taskboard"
        chk "contexte courant sur le namespace taskboard" "[ \"\$(kubectl config view --minify -o jsonpath='{..namespace}')\" = taskboard ]" "kubectl config set-context --current --namespace=taskboard"
        chk "PostgreSQL disponible (1/1)" "[ \"\$(avail taskboard postgres)\" = 1 ]" "kubectl logs deploy/postgres"
        chk "taskboard disponible (3/3)" "[ \"\$(avail taskboard taskboard)\" = 3 ]" "kubectl get pods ; kubectl describe pod <pod>"
        chk "Service LoadBalancer : réponse de /api/version" "curl -fsS -m 5 http://\$(lb_ip)/api/version | grep -q version=" "kubectl get svc taskboard-lb"
        chk "NodePort 30080 : réponse sur localhost:8080" "curl -fsS -m 5 http://localhost:8080/api/version | grep -q version=" "kubectl get svc taskboard-np"
        ;;
      03)
        chk "Deployment piloté par un fichier (kubectl apply)" "k -n taskboard get deploy taskboard -o jsonpath='{.metadata.annotations.kubectl\.kubernetes\.io/last-applied-configuration}' | grep -q ." "kubectl apply -f taskboard.yaml"
        chk "init container attente-postgres" "k -n taskboard get deploy taskboard -o jsonpath='{.spec.template.spec.initContainers[0].name}' | grep -qx attente-postgres" "étape 6"
        chk "taskboard disponible (3/3)" "[ \"\$(avail taskboard taskboard)\" = 3 ]"
        chk "PostgreSQL disponible (1/1)" "[ \"\$(avail taskboard postgres)\" = 1 ]" "kubectl scale deploy/postgres --replicas=1"
        chk "aucun pod orphelin (app=hors-service)" "[ -z \"\$(k -n taskboard get pods -l app=hors-service -o name)\" ]" "kubectl delete pod -l app=hors-service"
        ;;
      04)
        chk "sondes startup, readiness et liveness" "[ \"\$(tpl '.containers[0].startupProbe.httpGet.path')\" = /actuator/health/liveness ] && [ \"\$(tpl '.containers[0].readinessProbe.httpGet.path')\" = /actuator/health/readiness ] && [ \"\$(tpl '.containers[0].livenessProbe.httpGet.path')\" = /actuator/health/liveness ]" "étape 2 ; panne : remettre /liveness"
        chk "requests CPU et mémoire, limite mémoire" "[ -n \"\$(tpl '.containers[0].resources.requests.cpu')\" ] && [ -n \"\$(tpl '.containers[0].resources.requests.memory')\" ] && [ -n \"\$(tpl '.containers[0].resources.limits.memory')\" ]" "étape 3"
        chk "taskboard disponible (3/3)" "[ \"\$(avail taskboard taskboard)\" = 3 ]" "kubectl get pods ; kubectl describe pod <pod>"
        chk "aucun redémarrage en cours" "toutes_pretes" "pannes : requests.cpu à 100m, limits.memory à 512Mi"
        ;;
      05)
        chk "ConfigMap taskboard-config utilisée" "tpl '.containers[0].envFrom[*].configMapRef.name' | grep -qw taskboard-config" "étape 1 : envFrom"
        chk "Secret postgres-cred utilisé par taskboard et PostgreSQL" "tpl '..secretKeyRef.name' | grep -qw postgres-cred && k -n taskboard get deploy postgres -o jsonpath='{..secretKeyRef.name}' | grep -qw postgres-cred" "étape 3"
        chk "aucun mot de passe en clair dans les Deployments" "[ -z \"\$(k -n taskboard get deploy -o json | jq -r '.items[].spec.template.spec.containers[].env[]? | select(.name|test(\"PASSWORD\")) | .value // empty')\" ]" "étape 3 : valueFrom.secretKeyRef"
        chk "namespace en Pod Security « restricted »" "[ \"\$(k get ns taskboard -o jsonpath='{.metadata.labels.pod-security\\.kubernetes\\.io/enforce}')\" = restricted ]" "étape 5, c"
        chk "taskboard disponible (3/3)" "[ \"\$(avail taskboard taskboard)\" = 3 ] && toutes_pretes" "panne : runAsUser numérique"
        ;;
      06)
        chk "Service headless taskboard-pods" "[ \"\$(k -n taskboard get svc taskboard-pods -o jsonpath='{.spec.clusterIP}')\" = None ]" "étape 2, b"
        chk "Service personnalisé registre (sans sélecteur)" "[ -z \"\$(k -n taskboard get svc registre -o jsonpath='{.spec.selector}')\" ] && k -n taskboard exec outils -- wget -qO- -T 5 registre:5000/v2/_catalog | grep -q taskboard" "étape 3 : adresse dans l'EndpointSlice ?"
        chk "Gateway entree programmée" "[ \"\$(k -n taskboard get gateway entree -o jsonpath='{.status.conditions[?(@.type==\"Programmed\")].status}')\" = True ]" "étape 4"
        chk "HTTPRoute taskboard : réponse sur taskboard.local" "curl -fsS -m 5 -H 'Host: taskboard.local' http://\$(gw_ip)/api/version | grep -q version=" "étape 4 ; panne : sélecteur app=taskboard"
        chk "Service taskboard-lb : 3 pods derrière" "[ \"\$(k -n taskboard get endpointslices -l kubernetes.io/service-name=taskboard-lb -o json | jq '[.items[].endpoints[]? | select(.conditions.ready)] | length')\" -eq 3 ]" "panne : kubectl get endpointslices"
        ;;
      07)
        chk "taskboard en version 2.0.0 (3/3)" "tpl '.containers[0].image' | grep -q ':2\\.0\\.0\$' && [ \"\$(avail taskboard taskboard)\" = 3 ] && toutes_pretes" "étape 4 : rollout undo, fichier en 2.0.0"
        chk "stratégie maxSurge 1, maxUnavailable 0" "[ \"\$(k -n taskboard get deploy taskboard -o jsonpath='{.spec.strategy.rollingUpdate.maxSurge} {.spec.strategy.rollingUpdate.maxUnavailable}')\" = '1 0' ]" "étape 1"
        chk "preStop en place" "[ -n \"\$(tpl '.containers[0].lifecycle.preStop.sleep.seconds')\" ]" "étape 2"
        chk "historique : causes de changement renseignées" "k -n taskboard get rs -l app=taskboard -o jsonpath='{..kubernetes\\.io/change-cause}' | grep -q ." "kubectl annotate deployment taskboard kubernetes.io/change-cause=…"
        chk "canary retiré, route à 100 % vers la version stable" "! k -n taskboard get deploy taskboard-canary && ! k -n taskboard get httproute taskboard -o jsonpath='{..backendRefs[*].name}' | grep -q canary" "kubectl delete -f canary.yaml ; kubectl apply -f ~/labs/lab06/gateway.yaml"
        chk "fichier et cluster alignés (kubectl diff)" "[ -f ~/labs/lab07/taskboard.yaml ] && k -n taskboard diff -f ~/labs/lab07/taskboard.yaml" "étape 4 : remettre 2.0.0 dans le fichier"
        ;;
      *) die "Lab inconnu : $n (labs disponibles : 00 à 07)" ;;
    esac
    chk_fin "$n"
}

# Reconstruit l'état de fin du lab N (2 à 7) à partir des fichiers de solution.
# Les labs se cumulent : l'état du lab 5 contient celui des labs 2, 3 et 4.
SOL="$ROOT/solutions"
etat_fin() {
    local n=$1 ns="-n taskboard"
    log "État de fin du lab $(printf '%02d' "$n")"
    if [ "$n" -le 4 ]; then
        k apply -f "$SOL/lab02/taskboard.yaml" >/dev/null
        [ "$n" -ge 3 ] && k apply -f "$SOL/lab03/taskboard.yaml" >/dev/null
        [ "$n" -ge 4 ] && k apply -f "$SOL/lab04/taskboard.yaml" >/dev/null
        k $ns delete pod -l app=hors-service --ignore-not-found >/dev/null
    else
        # Lab 5 et suivants : namespace et Services du lab 2, sans ses Deployments
        # (mot de passe en clair, refusés par Pod Security « restricted »)
        yq 'select(.kind != "Deployment")' "$SOL/lab02/taskboard.yaml" | k apply -f - >/dev/null
        k $ns create secret generic postgres-cred --from-literal=username=taskboard \
            --from-literal=password=Tb-2026-formation --dry-run=client -o yaml | k apply -f - >/dev/null
        k apply -f "$SOL/lab05/configmaps.yaml" >/dev/null
        k label --overwrite namespace taskboard pod-security.kubernetes.io/warn=restricted \
            pod-security.kubernetes.io/enforce=restricted >/dev/null
        k apply -f "$SOL/lab05/postgres.yaml" >/dev/null
        k $ns rollout status deploy/postgres --timeout=180s >/dev/null
        if [ "$n" -ge 7 ]; then
            k apply -f "$SOL/lab07/taskboard.yaml" >/dev/null
            k $ns annotate --overwrite deploy/taskboard kubernetes.io/change-cause="état de fin du lab 7 (dokub)" >/dev/null
        else
            k apply -f "$SOL/lab05/taskboard.yaml" >/dev/null
        fi
        if [ "$n" -ge 6 ]; then
            k $ns apply -f "$ROOT/labs/commun/outils.yaml" >/dev/null
            k $ns apply -f "$ROOT/labs/lab06/taskboard-pods.yaml" >/dev/null
            k $ns apply -f "$ROOT/labs/lab06/gateway.yaml" >/dev/null
            local ip; ip=$(docker inspect "$REG_NAME" -f '{{.NetworkSettings.Networks.kind.IPAddress}}')
            sed "s/172\.18\.0\.5/$ip/" "$ROOT/labs/lab06/registre.yaml" | k $ns apply -f - >/dev/null
        fi
        k $ns delete deploy taskboard-canary bv-bleu bv-vert --ignore-not-found >/dev/null
    fi
    k $ns rollout status deploy/postgres --timeout=180s >/dev/null || { diag taskboard app=postgres; exit 1; }
    k $ns rollout status deploy/taskboard --timeout=300s >/dev/null || { diag taskboard app=taskboard; exit 1; }
    ok "taskboard disponible"
}

cmd_lab_start() {
    local n=${1:-}
    case $n in
      00) cmd_images; ok "Prêt pour le lab 0" ;;
      01) if cluster_exists; then warn "Le cluster « dokub » existe déjà. Pour refaire le lab 1 depuis le début : dokub cluster down"
          else ok "Prêt pour le lab 1 : aucun cluster, à vous de le créer"; fi ;;
      02) cmd_cluster_up
          k delete namespace taskboard --ignore-not-found --wait=true >/dev/null
          kubectl config set-context "$CTX" --namespace=default >/dev/null
          ok "Prêt pour le lab 2 : cluster complet, namespace taskboard absent" ;;
      03|04|05|06|07|08)
          cmd_cluster_up
          etat_fin $((10#$n - 1))
          kubectl config set-context "$CTX" --namespace=taskboard >/dev/null
          ok "Prêt pour le lab $n : état de fin du lab $(printf '%02d' $((10#$n - 1))), contexte sur taskboard" ;;
      *) die "Lab inconnu : $n (labs disponibles : 00 à 08)" ;;
    esac
}

# ────────────────────────────────────────────────
case "${1:-} ${2:-}" in
    "cluster up")     cmd_cluster_up ;;
    "cluster down")   cmd_cluster_down ;;
    "cluster status") cmd_cluster_status ;;
    "images "*)       cmd_images ;;
    "mesure "*)       cmd_mesure ;;
    "diag-rollout "*) cmd_diag_rollout ;;
    "lab start")      cmd_lab_start "${3:-}" ;;
    "lab check")      cmd_lab_check "${3:-}" ;;
    *) sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
